# ============================================================================
# TCC: Variáveis de Ambiente - Backend Node.js
# IMPORTANTE: Copie este arquivo para .env e preencha com suas credenciais
# ============================================================================

# Servidor
PORT=3000
NODE_ENV=development

# PostgreSQL (preencher após executar o script database/schema.sql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_medica
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# CORS (Frontend React rodará em http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
