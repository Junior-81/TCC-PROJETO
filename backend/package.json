{
  "name": "tcc-plataforma-medica-backend",
  "version": "1.0.0",
  "description": "TCC: Engenharia de Plataforma para Sistemas Médicos Legados - Backend Node.js",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run lint:spectral && tsc",
    "start": "node dist/index.js",
    "lint:spectral": "spectral lint ../swagger.yaml --ruleset ../.spectral.yaml",
    "test": "jest --runInBand"
  },
  "keywords": [
    "tcc",
    "engenharia-plataforma",
    "api-governance",
    "lgpd",
    "healthtech"
  ],
